<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <PackageId>ManiaAPI.UnitedLadder</PackageId>
        <Version>2.11.0</Version>
        <Authors>BigBang1112</Authors>
        <Description>Wrapper for the new UnitedLadder API (ul.unitedascenders.xyz). Part of the ManiaAPI.NET library set.</Description>
        <Copyright>Copyright (c) 2022-2026 Petr Pivoňka</Copyright>
        <PackageProjectUrl>https://github.com/BigBang1112/maniaapi-net</PackageProjectUrl>
        <PackageIcon>logo_icon_outline.png</PackageIcon>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageTags>trackmania, maniaplanet, tm, api, web, maniaapi, maniaapi.net, unitedladder</PackageTags>
        <PackageReleaseNotes>
- Added `GetSoloRankingsAsync`, `GetMultiplayerRankingsAsync`, `GetTrackLeaderboardAsync`, and `GetLeaderboardSnapshotAsync`
- Added `GetPlayerMapsAsync`, `GetPlayerSoloBreakdownAsync`, `GetPlayerHistoryAsync`, and `GetPlayerProgressionAsync`
- Added `CheckLoginAsync`, `GetReplayResponseAsync`, and a `forceWebServices` overload of `GetPlayerAsync`
- Added constructors with an application User-Agent
        </PackageReleaseNotes>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
    </PropertyGroup>

    <PropertyGroup>
        <TargetFrameworks>net11.0;net10.0;net9.0;net8.0</TargetFrameworks>
        <LangVersion>14</LangVersion>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsTrimmable>true</IsTrimmable>
        <IsAotCompatible>true</IsAotCompatible>

        <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>

        <PublishRepositoryUrl>true</PublishRepositoryUrl>
        <EmbedUntrackedSources>true</EmbedUntrackedSources>

        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <DocumentationFile>bin\$(Configuration)\$(TargetFramework)\$(AssemblyName).xml</DocumentationFile>
        <NoWarn>1591</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <None Include="../../logo_icon_outline.png" Pack="true" PackagePath="\" />
        <None Include="README.md" Pack="true" PackagePath="\" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="ManiaAPI.UnitedLadder.Tests" />
    </ItemGroup>

</Project>
