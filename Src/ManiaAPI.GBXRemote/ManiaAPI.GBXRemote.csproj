<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <PackageId>ManiaAPI.GBXRemote</PackageId>
        <Version>2.10.0</Version>
        <Authors>BigBang1112</Authors>
        <Description>Integrates the GBXRemote (XML-RPC) communication used between controllers and servers. Part of the ManiaAPI.NET library set.</Description>
        <Copyright>Copyright (c) 2022-2026 Petr Pivoňka</Copyright>
        <PackageProjectUrl>https://github.com/BigBang1112/maniaapi-net</PackageProjectUrl>
        <PackageIcon>logo_icon_outline.png</PackageIcon>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageTags>trackmania, maniaplanet, tm, api, web, maniaapi, maniaapi.net, gbxremote, xml-rpc</PackageTags>
        <PackageReleaseNotes>
- **Renamed `ManiaAPI.XmlRpc` to `ManiaAPI.GBXRemote`**. Update package references and namespaces, and replace `XmlRpcClient`, `XmlRpcCall`, `XmlRpcCallResult`, `XmlRpcCallback`, and `XmlRpcCallbackMessage` with their `GBXRemote` equivalents
- Fixed concurrent calls interleaving writes on the same connection
- Fixed calls hanging after disconnection and sockets leaking when connection setup fails
- Fixed malformed callbacks stopping callback processing, invalid payload sizes causing excessive allocations, and integer serialization depending on the current culture
- Added .NET 11 support
        </PackageReleaseNotes>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
    </PropertyGroup>

    <PropertyGroup>
        <TargetFrameworks>net11.0;net10.0;net9.0;net8.0</TargetFrameworks>
        <LangVersion>14</LangVersion>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsTrimmable>true</IsTrimmable>
        <IsAotCompatible>true</IsAotCompatible>

        <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>

        <PublishRepositoryUrl>true</PublishRepositoryUrl>
        <EmbedUntrackedSources>true</EmbedUntrackedSources>

        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <DocumentationFile>bin\$(Configuration)\$(TargetFramework)\$(AssemblyName).xml</DocumentationFile>
        <NoWarn>1591</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <None Include="../../logo_icon_outline.png" Pack="true" PackagePath="\" />
        <None Include="README.md" Pack="true" PackagePath="\" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="ManiaAPI.GBXRemote.Tests" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.2" />
        <PackageReference Include="MinimalXmlReader" Version="0.2.1" />
        <PackageReference Include="TmEssentials" Version="2.6.0" />
    </ItemGroup>

</Project>
