nadeo.core.favorite_maps_by_uids|service
nadeo.core.favorite_skins|service
nadeo.core.map_vote|service
nadeo.core.skins_by_account_ids|service
nadeo.core.skin_by_account_id|service
nadeo.core.player_club_tags|service
nadeo.core.player_trophy_summary|service
nadeo.core.player_trophy_history|service
nadeo.live.dedicated_server_accounts|service
