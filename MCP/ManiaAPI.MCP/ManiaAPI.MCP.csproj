<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>14</LangVersion>
    <PackAsTool>true</PackAsTool>
    <IsPackable>true</IsPackable>
    <ToolCommandName>maniaapi-mcp</ToolCommandName>
    <PackageId>ManiaAPI.MCP</PackageId>
    <Version>0.1.0</Version>
    <Authors>BigBang1112</Authors>
    <Description>Stateless MCP gateway for ManiaAPI.NET.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <UserSecretsId>ManiaAPI.MCP</UserSecretsId>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="ModelContextProtocol" Version="2.2.0" />
    <PackageReference Include="ModelContextProtocol.AspNetCore" Version="2.2.0" />
    <PackageReference Include="JsonSchema.Net" Version="7.3.4" />
    <ProjectReference Include="../../Src/ManiaAPI.NadeoAPI.Extensions.Hosting/ManiaAPI.NadeoAPI.Extensions.Hosting.csproj" />
    <ProjectReference Include="../../Src/ManiaAPI.TrackmaniaAPI.Extensions.Hosting/ManiaAPI.TrackmaniaAPI.Extensions.Hosting.csproj" />
    <ProjectReference Include="../../Src/ManiaAPI.TMX.Extensions.Hosting/ManiaAPI.TMX.Extensions.Hosting.csproj" />
    <ProjectReference Include="../../Src/ManiaAPI.MasterServer.Extensions.Hosting/ManiaAPI.MasterServer.Extensions.Hosting.csproj" />
    <ProjectReference Include="../../Src/ManiaAPI.ManiaPlanetAPI.Extensions.Hosting/ManiaAPI.ManiaPlanetAPI.Extensions.Hosting.csproj" />
    <ProjectReference Include="../../Src/ManiaAPI.TrackmaniaWS.Extensions.Hosting/ManiaAPI.TrackmaniaWS.Extensions.Hosting.csproj" />
    <ProjectReference Include="../../Src/ManiaAPI.UnitedLadder/ManiaAPI.UnitedLadder.csproj" />
    <ProjectReference Include="../../Src/ManiaAPI.NadeoAPI.Extensions.Gbx/ManiaAPI.NadeoAPI.Extensions.Gbx.csproj" />
    <ProjectReference Include="../../Src/ManiaAPI.TMX.Extensions.Gbx/ManiaAPI.TMX.Extensions.Gbx.csproj" />
    <ProjectReference Include="../../Generators/ManiaAPI.MCP.Generators/ManiaAPI.MCP.Generators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <None Include="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
  <ItemGroup>
    <AdditionalFiles Include="../../Src/ManiaAPI.NadeoAPI/NadeoServices.cs" />
    <AdditionalFiles Include="../../Src/ManiaAPI.NadeoAPI/NadeoLiveServices.cs" />
    <AdditionalFiles Include="../../Src/ManiaAPI.NadeoAPI/NadeoMeetServices.cs" />
    <AdditionalFiles Include="../../Src/ManiaAPI.TrackmaniaAPI/TrackmaniaAPI.cs" />
    <AdditionalFiles Include="../../Src/ManiaAPI.TMX/TMX.cs" />
    <AdditionalFiles Include="../../Src/ManiaAPI.TMX/MX.cs" />
    <AdditionalFiles Include="Catalog/Overrides.accounts" />
    <AdditionalFiles Include="../../Src/ManiaAPI.MasterServer/**/*.cs" Exclude="../../Src/ManiaAPI.MasterServer/obj/**/*.cs;../../Src/ManiaAPI.MasterServer/bin/**/*.cs" />
    <AdditionalFiles Include="../../Src/ManiaAPI.ManiaPlanetAPI/ManiaPlanetAPI.cs" />
    <AdditionalFiles Include="../../Src/ManiaAPI.ManiaPlanetAPI/ManiaPlanetIngameAPI.cs" />
    <AdditionalFiles Include="../../Src/ManiaAPI.TrackmaniaWS/TrackmaniaWS.cs" />
    <AdditionalFiles Include="../../Src/ManiaAPI.UnitedLadder/UnitedLadder.cs" />
  </ItemGroup>
</Project>
